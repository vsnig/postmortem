{
  "manifest_version": 3,
  "name": "Postmortem — stop the \"one more game\" reflex",
  "version": "0.1.0",
  "description": "Blocks Rematch / New Game on Lichess and Chess.com for 15 min, so you analyze the game you just played instead of tilting into more.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Postmortem — click to block new games for 15 min (click again to unblock)",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "sites/lichess.js",
        "blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "sites/chesscom.js",
        "blocker.js"
      ],
      "run_at": "document_start"
    }
  ]
}
